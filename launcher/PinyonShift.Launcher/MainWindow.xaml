<Window x:Class="PinyonShift.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinyon Shift" Width="1180" Height="780" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource InkBrush}"
        Foreground="{StaticResource FogBrush}" Icon="Branding/pinyon-shift.ico"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Hero art behind the title bar and the hero. -->
            <Grid Grid.RowSpan="2" ClipToBounds="True">
                <Border Background="{StaticResource HeroGradient}"/>
                <!-- In a zero-size canvas, so the art never sizes the rows it spans. -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0">
                    <Image Source="Branding/mark-light.png" Height="430" Opacity="0.06"
                           Canvas.Left="-500" Canvas.Top="-10" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Canvas>
                <!-- Pinyon ridges. -->
                <Path VerticalAlignment="Bottom" Height="150" Stretch="Fill" Opacity="0.55"
                      Data="M0,150 L0,96 L70,62 L120,84 L190,40 L260,78 L330,52 L400,86 L470,48 L560,82 L630,58 L720,90 L800,50 L880,80 L960,44 L1040,76 L1120,54 L1180,70 L1180,150 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E4A30" Offset="0"/>
                            <GradientStop Color="#0A0F0C" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path VerticalAlignment="Bottom" Height="92" Stretch="Fill" Opacity="0.9"
                      Data="M0,92 L0,64 L40,44 L60,56 L90,30 L120,52 L170,38 L230,60 L290,34 L340,56 L400,42 L470,66 L540,36 L600,58 L660,44 L740,64 L820,32 L880,54 L950,40 L1020,62 L1090,38 L1140,52 L1180,44 L1180,92 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#123321" Offset="0"/>
                            <GradientStop Color="#0A0F0C" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <!-- The road from the logo, winding across the ridge. -->
                <Path VerticalAlignment="Bottom" Height="70" Stretch="Fill" Opacity="0.35"
                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="6 5"
                      Data="M0,60 C160,20 300,70 470,42 S760,8 900,36 S1100,62 1180,30"/>
                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource LineBrush}"/>
            </Grid>

            <!-- Title bar. -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <Image DockPanel.Dock="Left" Source="Branding/logo-light.png" Height="24" Margin="26,0,0,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" x:Name="ChannelText" Text="PREVIEW" FontSize="10"
                           FontFamily="Bahnschrift SemiBold" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="12,3,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"
                            AutomationProperties.Name="Minimize">
                        <Path Data="M0,0.5 L10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                            Click="MaximizeButton_Click" AutomationProperties.Name="Maximize">
                        <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="CloseButton_Click"
                            AutomationProperties.Name="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1"/>
                    </Button>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#66101813" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="SYSTEM READY" FontSize="10.5"
                                   FontFamily="Bahnschrift SemiBold"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Hero. -->
            <Grid Grid.Row="1" Margin="48,26,48,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="EyebrowText" Text="READY FOR YOUR DISC" Style="{StaticResource Eyebrow}"/>
                <TextBlock Grid.Row="1" x:Name="HeadlineText" Text="Build your preview."
                           FontFamily="Bahnschrift SemiBold" FontSize="46" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" x:Name="SubheadText" MaxWidth="620" HorizontalAlignment="Left"
                           TextWrapping="Wrap" LineHeight="22" FontSize="14.5" Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,0"
                           Text="Your game stays yours. The launcher verifies your disc image, builds the native translation on this PC, and keeps every generated file local."/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,26,0,0">
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" MinWidth="230"
                            IsEnabled="False" Click="PrimaryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PrimaryIcon" Data="M0,0 L0,14 L11,7 Z" Fill="{StaticResource InkBrush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="PrimaryButtonText" Text="VERIFY &amp; BUILD"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontFamily="Bahnschrift SemiBold" FontSize="17" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GraphicsSettingsButton" Content="GRAPHICS" Style="{StaticResource QuietButton}"
                            Height="56" Padding="24,0" Margin="14,0,0,0" Visibility="Collapsed"
                            Click="GraphicsSettingsButton_Click"
                            AutomationProperties.HelpText="Choose the graphics API and the internal resolution."/>
                </StackPanel>

                <!-- Route: five steps. -->
                <ItemsControl Grid.Row="4" x:Name="RouteList" Margin="0,30,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" Background="{Binding Brush}"
                                        BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <TextBlock Text="{Binding Marker}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontFamily="Bahnschrift SemiBold" Foreground="{StaticResource InkBrush}"/>
                                </Border>
                                <Border Grid.Column="1" Height="2" CornerRadius="1" Background="{Binding Brush}"
                                        Opacity="0.55" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="13.5"
                                           FontFamily="Bahnschrift SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Content: one panel at a time. -->
            <Grid Grid.Row="2" Margin="48,24,48,18">

                <!-- Setup: the disc image and where the build goes. -->
                <Grid x:Name="SetupPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DropZone" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                            BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="0" Padding="24,20">
                        <Grid>
                            <Rectangle x:Name="DropOutline" RadiusX="14" RadiusY="14" Margin="-24,-20"
                                       Stroke="{StaticResource LineStrongBrush}" StrokeThickness="1.5"
                                       StrokeDashArray="5 4" IsHitTestVisible="False"/>
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="21"
                                            Background="{StaticResource PanelRaisedBrush}" Margin="0,0,14,0">
                                        <!-- Disc glyph. -->
                                        <Grid Width="22" Height="22">
                                            <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"/>
                                            <Ellipse Width="6" Height="6" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"/>
                                        </Grid>
                                    </Border>
                                    <Button DockPanel.Dock="Right" x:Name="BrowseButton" Content="CHOOSE ISO"
                                            Style="{StaticResource QuietButton}" VerticalAlignment="Center"
                                            Click="BrowseButton_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="FORZA HORIZON DISC IMAGE" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="DropHintText" Text="Drop your .iso here, or choose it."
                                                   FontSize="16" FontFamily="Bahnschrift SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="1" Margin="0,18,0,0">
                                    <TextBox x:Name="IsoPathTextBox" IsReadOnly="True"
                                             ToolTip="Select your personally dumped supported Xbox 360 disc image."/>
                                    <TextBlock Text="No disc image selected yet" Margin="14,0" VerticalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                               Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=IsoPathTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <CheckBox Grid.Row="2" x:Name="OwnershipCheckBox" Margin="0,18,0,0"
                                          FontFamily="Bahnschrift" FontSize="13" Checked="InputChanged" Unchecked="InputChanged">
                                    <TextBlock Text="I own this copy and dumped it from my own disc." TextWrapping="Wrap"
                                               Foreground="{StaticResource FogBrush}"/>
                                </CheckBox>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="SUPPORTED DISC" Style="{StaticResource Label}"/>
                                <TextBlock Text="USA retail · MS-2505" FontSize="16" FontFamily="Bahnschrift SemiBold"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="Verified by exact size and SHA-256 before anything is extracted."
                                           FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="LOCAL BUILD" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="BuildLocationText" Text="%LOCALAPPDATA%\PinyonShift" FontSize="13"
                                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                           FontFamily="Cascadia Mono, Consolas"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="ChooseInstallRootButton" Content="CHANGE FOLDER" IsEnabled="False"
                                        Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Click="ChooseInstallRootButton_Click"
                                        ToolTip="Choose a build location. Existing files and saves stay in place. Available for packaged launchers without an installation-root override."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Ready: what the next start uses, and where it lives. -->
                <Grid x:Name="ReadyPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <UniformGrid Rows="1" Columns="3" VerticalAlignment="Top">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="22,18" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="GRAPHICS API" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ApiTileText" Text="Vulkan" FontSize="24" FontFamily="Bahnschrift SemiBold"
                                       Margin="0,6,0,0"/>
                            <TextBlock x:Name="ApiTileDetail" Text="Recorded on a second thread" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="22,18" Margin="9,0">
                        <StackPanel>
                            <TextBlock Text="INTERNAL RESOLUTION" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ResolutionTileText" Text="1×" FontSize="24" FontFamily="Bahnschrift SemiBold"
                                       Margin="0,6,0,0"/>
                            <TextBlock x:Name="ResolutionTileDetail" Text="1280 × 720" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="22,18" Margin="9,0,0,0">
                        <StackPanel>
                            <TextBlock Text="IN GAME" Style="{StaticResource Label}"/>
                            <TextBlock Text="Press F6" FontSize="24" FontFamily="Bahnschrift SemiBold" Margin="0,6,0,0"/>
                            <TextBlock Text="Display, graphics, audio and controls, applied as you play." FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="22,16"
                        Margin="0,18,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="OPEN FOLDER" Style="{StaticResource QuietButton}"
                                VerticalAlignment="Center" Click="OpenStateFolderButton_Click"
                                AutomationProperties.HelpText="Open the folder with your saves, settings and logs."/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="SAVES AND SETTINGS" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="StateRootText" FontSize="13" Margin="0,6,0,0"
                                       FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                </Grid>

                <!-- Progress and the build log. -->
                <Border x:Name="LogPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Visibility="Collapsed">
                    <Grid Margin="22,18,22,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" x:Name="ProgressText" Text="0%" FontSize="13"
                                       FontFamily="Bahnschrift SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="ProgressMessageText" Text="Waiting to start." FontSize="13"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                        </DockPanel>
                        <ProgressBar Grid.Row="1" x:Name="BuildProgress" Minimum="0" Maximum="100" Value="0"
                                     Margin="0,12,0,0"/>
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="DETAILS" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" x:Name="LogToggleButton" Content="HIDE"
                                        Style="{StaticResource LinkButton}" Click="LogToggleButton_Click"/>
                            </DockPanel>
                            <Border Grid.Row="1" x:Name="LogBox" Background="#0B120E" CornerRadius="10" Margin="0,6,0,0">
                                <TextBox x:Name="LogTextBox" BorderThickness="0" Background="Transparent"
                                         FontSize="11.5" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Padding="14,10"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- A caught crash. -->
                <Border x:Name="CrashPanel" Background="#1D1512" BorderBrush="{StaticResource RedBrush}"
                        BorderThickness="1" CornerRadius="14" Visibility="Collapsed"
                        AutomationProperties.Name="Crash report ready">
                    <Grid Margin="26,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="The game closed unexpectedly." FontFamily="Bahnschrift SemiBold" FontSize="24"/>
                        <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="#C8B7AF" TextWrapping="Wrap" LineHeight="20"
                                   Text="We caught the crash and prepared a privacy-safe diagnostic ZIP. One click opens a prefilled GitHub report and selects the file you need to attach."/>
                        <Border Grid.Row="2" Background="#15100E" BorderBrush="#573C35" BorderThickness="1"
                                CornerRadius="10" Padding="16,12" Margin="0,17,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CRASH ID" FontSize="10.5" Foreground="#C8B7AF"/>
                                    <TextBlock x:Name="CrashIdText" Text="pscrash-v1-pending" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="13" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="SAFE TO ATTACH" FontSize="10.5" Foreground="#C8B7AF"/>
                                    <TextBlock Text="No game files, saves, generated code, or memory dump"
                                               FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="3" Margin="0,15,0,0" VerticalAlignment="Top" Foreground="#C8B7AF"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Text="The local crash dump stays on this computer. Maintainers may request it privately if the sanitized report is not enough."/>
                    </Grid>
                </Border>

                <!-- Graphics settings read before the game starts. -->
                <Border x:Name="GraphicsPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                        Visibility="Collapsed" AutomationProperties.Name="Graphics settings">
                    <Grid Margin="26,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="BACK" Style="{StaticResource QuietButton}"
                                    VerticalAlignment="Top" Click="CloseGraphicsButton_Click"
                                    AutomationProperties.Name="Close graphics settings"/>
                            <StackPanel>
                                <TextBlock Text="GRAPHICS" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="Chosen before the game starts." FontFamily="Bahnschrift SemiBold"
                                           FontSize="24" Margin="0,5,0,0"/>
                                <TextBlock Text="Everything else (display, graphics, audio, controls) is in the game: press F6 while playing."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GRAPHICS API" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="GraphicsApiComboBox" Margin="0,8,0,0" SelectedIndex="0"
                                          AutomationProperties.Name="Graphics API">
                                    <ComboBoxItem Tag="vulkan">Vulkan · recommended</ComboBoxItem>
                                    <ComboBoxItem Tag="d3d12">Direct3D 12</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="Vulkan records draws on a second thread and reaches 120 fps at 1×. Direct3D 12 is faster at 3× and above, and prepares shader packs before its first start."
                                           FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="INTERNAL RESOLUTION" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="ResolutionComboBox" Margin="0,8,0,0" SelectedIndex="0"
                                          AutomationProperties.Name="Internal resolution">
                                    <ComboBoxItem Tag="1">1× · 1280 × 720</ComboBoxItem>
                                    <ComboBoxItem Tag="2">2× · 2560 × 1440</ComboBoxItem>
                                    <ComboBoxItem Tag="3">3× · 3840 × 2160 (experimental)</ComboBoxItem>
                                    <ComboBoxItem Tag="4">4× · 5120 × 2880 (experimental)</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="On Vulkan 1× runs at up to 120 fps and 2× above 60; at 3× and 4× choose Direct3D 12. Output is scaled to your display, with FSR 1 if chosen in game."
                                           FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                        </Grid>
                        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="InGameSettingsButton" Content="OTHER SETTINGS"
                                        Style="{StaticResource LinkButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Click="InGameSettingsButton_Click"
                                        AutomationProperties.Name="Where the other settings are"/>
                                <Button x:Name="RestoreGraphicsButton" Content="RESTORE BACKUP" Style="{StaticResource QuietButton}"
                                        Margin="0,0,10,0" Click="RestoreGraphicsButton_Click"/>
                                <Button x:Name="ResetGraphicsButton" Content="RESET DEFAULTS" Style="{StaticResource QuietButton}"
                                        Margin="0,0,10,0" Click="ResetGraphicsButton_Click"/>
                                <Button x:Name="SaveGraphicsButton" Content="SAVE SETTINGS" Style="{StaticResource ActionButton}"
                                        Click="SaveGraphicsButton_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="GraphicsStatusText" Text="Loading current settings…" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,18,0" AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer. -->
            <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="40,0,40,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="Pinyon Shift" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="  ·  Unofficial community project, not affiliated with Microsoft or Playground Games"
                                   FontSize="11.5" Foreground="{StaticResource FaintBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OpenLogsButton" Content="OPEN LOGS" Style="{StaticResource LinkButton}"
                                Visibility="Collapsed" Click="OpenLogsButton_Click"/>
                        <Button x:Name="ReportProblemButton" Content="REPORT A PROBLEM" Style="{StaticResource LinkButton}"
                                Margin="6,0,0,0" Click="ReportProblemButton_Click"
                                AutomationProperties.HelpText="Open the Pinyon Shift bug report form on GitHub."/>
                        <Button Content="GITHUB" Style="{StaticResource LinkButton}" Margin="6,0,0,0"
                                Click="ProjectButton_Click" AutomationProperties.HelpText="Open the project on GitHub."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Shown while an .iso is dragged over the window. -->
            <Border x:Name="DropOverlay" Grid.RowSpan="4" Background="#E60A0F0C" Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="18"
                        Margin="40" Background="#2012261A">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="Branding/mark-light.png" Height="96" Opacity="0.9"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Drop your disc image" FontSize="28" FontFamily="Bahnschrift SemiBold"
                                   HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBlock Text="It is verified before anything is extracted." FontSize="14"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
