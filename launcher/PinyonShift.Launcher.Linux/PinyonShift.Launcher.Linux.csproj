<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PinyonShiftLauncher</AssemblyName>
    <RootNamespace>PinyonShift.Launcher.Linux</RootNamespace>
    <Version>0.4.0</Version>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Native Linux launcher for Pinyon Shift.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.21" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.21" />
    <AvaloniaResource Include="../PinyonShift.Launcher/Branding/*.png" Link="Branding/%(Filename)%(Extension)" />
    <Content Include="Notices/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
