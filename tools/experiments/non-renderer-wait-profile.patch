+REXCVAR_DEFINE_BOOL(profile_guest_object_waits, false, "Kernel",
+                   "Log completed guest object wait durations for isolated profiling");
+
 namespace rex::system {
 
+template <typename Callback>
+static auto ProfileObjectWait(const char* kind, Callback callback) {
+  if (!REXCVAR_GET(profile_guest_object_waits)) return callback();
+  const auto start = std::chrono::steady_clock::now();
+  auto result = callback();
+  const auto end = std::chrono::steady_clock::now();
+  const auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+      end - start).count();
+  // One bucket per thread and call site; avoid logging every zero-time poll.
+  static thread_local uint64_t count = 0, total_us = 0, maximum_us = 0;
+  static thread_local auto last_report = start;
+  ++count;
+  total_us += us;
+  maximum_us = std::max(maximum_us, static_cast<uint64_t>(us));
+  if (count >= 1024 || end - last_report >= std::chrono::seconds(1)) {
+    REXLOG_INFO("WAIT_PROFILE kind={} count={} total_us={} max_us={}",
+                kind, count, total_us, maximum_us);
+    count = total_us = maximum_us = 0;
+    last_report = end;
+  }
+  return result;
+}
