pinyon-shift-fh1-render-test-v1
# clock-hz 60
# Free roam at 1x, switched to 2x and back to 1x at run time (NP-4.7), as the
# RESOLUTION SCALE setting does. Needs packs for both scales staged
# (--shader-pack twice); the runtime log records each switch. Each switch
# holds the title for about a second (it waits for the GPU), so there is no
# simulation-time expectation.
# expect-image roam-1x 12 30 1.00
# expect-image roam-2x 12 30 1.00
# expect-image roam-1x-again 12 30 1.00
input 0 0000 0 0 0 0 0 0
input 360 1000 0 0 0 0 0 0
input 366 0000 0 0 0 0 0 0
input 480 1000 0 0 0 0 0 0
input 486 0000 0 0 0 0 0 0
input 600 1000 0 0 0 0 0 0
input 606 0000 0 0 0 0 0 0
input 720 1000 0 0 0 0 0 0
input 726 0000 0 0 0 0 0 0
input 780 0000 0 0 0 0 0 0
input 930 0000 0 0 0 0 0 0
capture 1200 roam-1x
cvar 1260 draw_resolution_scale_x 2
cvar 1261 draw_resolution_scale_y 2
capture 1500 roam-2x
cvar 1560 draw_resolution_scale_x 1
cvar 1561 draw_resolution_scale_y 1
capture 1800 roam-1x-again
stop 1830
