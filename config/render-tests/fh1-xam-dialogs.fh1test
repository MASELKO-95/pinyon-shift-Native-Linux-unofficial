# clock-hz 60
# NP-5.2: host XAM dialogs driven with hostkey steps.
input 0 0000 0 0 0 0 0 0
input 360 1000 0 0 0 0 0 0
input 366 0000 0 0 0 0 0 0
input 480 1000 0 0 0 0 0 0
input 486 0000 0 0 0 0 0 0
input 600 1000 0 0 0 0 0 0
input 606 0000 0 0 0 0 0 0
input 720 1000 0 0 0 0 0 0
input 726 0000 0 0 0 0 0 0
capture 1200 free-roam
xamdialog 1300 message
hostkey 1360 down
hostkey 1400 enter
xamdialog 1500 message
hostkey 1560 escape
xamdialog 1700 keyboard
hostkey 1760 up
hostkey 1780 up
hostkey 1800 up
hostkey 1830 right
hostkey 1860 down
hostkey 1880 down
hostkey 1900 down
hostkey 1940 enter
xamdialog 2100 keyboard
hostkey 2160 escape
capture 2300 after
stop 2400
